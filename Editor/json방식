using System;
using System.Runtime.InteropServices;
using Unity.VisualScripting;
using UnityEditor;
using UnityEngine;

[Serializable]
public struct PlayerData
{
    public string Name;
    public float Hp;
    public float Attack;
    public float Defence;
    public void SetData(string Name, float Hp, float Attack, float Defence)
    {
        this.Name = Name;
        this.Hp = Hp;
        this.Attack = Attack;
        this.Defence = Defence;
        
    }

}
[Serializable]
public enum Weapontype
{
    Sword,
    Axe,
    Bow,
    Wand,
    Hammer,
    Max,
}

[StructLayout(LayoutKind.Sequential, Pack = 1)]
public struct WeaponData
{
    public Weapontype Type;
    public float Power;     //공격력
    public float Speed;     //공속
    public float Durability;//내구도
    public float Critical;  //크리티컬
}


