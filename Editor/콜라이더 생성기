    private static void SaveSpriteFile(Sprite sprite, string path, Rect? rect = null)
    {
        Texture2D texture = sprite.texture;

        Color[] pixels;

        if (rect.HasValue)
        {
            int x = (int)rect.Value.x;
            int y = (int)rect.Value.y;
            int width = (int)rect.Value.width;
            int height = (int)rect.Value.height;

            pixels = texture.GetPixels(x, y, width, height);
        }
        else
            pixels = texture.GetPixels();


        Texture2D saveTexture;
        if(rect.HasValue)
            saveTexture = new Texture2D((int)rect.Value.width, (int)rect.Value.height);
        else
            saveTexture = new Texture2D(texture.width, texture.height);


        saveTexture.SetPixels(pixels);
        saveTexture.Apply();

        byte[] imageBytes = saveTexture.EncodeToPNG();
        File.WriteAllBytes(path, imageBytes);

        AssetDatabase.Refresh();
    }

    /// <summary>
    /// 스프라이트의 충돌 영역 계산
    /// </summary>
    /// <param name="sprite">대상 스프라이트</param>
    /// <param name="alpha">픽셀의 비교 투명도</param>
    /// <returns>계산된 충돌 영역</returns>
    private static Rect GetColliderRect(Sprite sprite, float alpha = 0.1f)
    {
        Texture2D texture = sprite.texture;
        Rect rect = sprite.rect;
        //Debug.Log($"원본 스프라이트 랙트 : {rect}");

        int width = (int)rect.width;
        int height = (int)rect.height;


        //Color[] pixels = texture.GetPixels();
        Color[] pixels = texture.GetPixels((int)rect.x, (int)rect.y, width, height);
        //Debug.Log($"픽셀 수 : {pixels.Count()}");

        int minX = width;
        int maxX = 0;
        int minY = height;
        int maxY = 0;

        for (int y = 0; y < height; y++)
        {
            for (int x = 0; x < width; x++)
            {
                if (pixels[y * width + x].a > alpha)
                {
                    if (x < minX) minX = x;
                    if (x > maxX) maxX = x;

                    if (y < minY) minY = y;
                    if (y > maxY) maxY = y;
                }
            }
        }

        if (minX > maxX || minY > maxY)
        {
            Debug.LogWarning("잘못된 스프라이트");
            return Rect.zero;
        }

        return new Rect(minX, minY, (maxX - minX) + 1, (maxY - minY) + 1);
    }

    private static void GetColliderSize(Sprite sprite, Rect rect,out Vector2 size, out Vector2 offset)
    {
        float ppu = sprite.pixelsPerUnit;
        
        size = new Vector2(rect.width / ppu , rect.height / ppu);
        
        float x = (rect.center.x - sprite.pivot.x) / ppu;
        float y = (rect.center.y - sprite.pivot.y) / ppu;

        offset = new Vector2 (x, y);
    }
}
