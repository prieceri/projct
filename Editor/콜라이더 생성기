        ColliderData ColliderData = ScriptableObject.CreateInstance<ColliderData>();

        Debug.Log($"{sprites.Count}개의 Sprite를 대상으로 생성합니다.");
        foreach (Sprite sprite in sprites)
        {
            Rect rect = GetColliderRect(sprite);

            Vector2 size, offset;
            GetColliderSize(sprites[0], rect, out size, out offset);

