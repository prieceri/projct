        //스프라이트 픽셀 저장 텍스트
        {
            //string savePath = "Assets/UnitTests/Sprite.png";
            //savePath = AssetDatabase.GenerateUniqueAssetPath(savePath);
            //Debug.Log(savePath);

            //SaveSpriteFile(sprites[0], savePath);
            //SaveSpriteFile(sprites[0], savePath, sprites[0].textureRect);
        }
        
        
        {
            //Debug.Log($"Sprite Rect : {sprites[0].rect}");
            //Debug.Log($"Sprite TextureRect : {sprites[0].textureRect}");
        }


        // 충돌영역 계산 텍스트
        {
            //Debug.Log($"{sprites[0].name}를 대상으로 테스팅 수행");
            //Rect rect = GetColliderRect(sprites[0]);
            //Debug.Log($"GetcolliderRect : {rect}");

