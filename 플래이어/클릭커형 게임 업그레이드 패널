/// <summary>
/// 업그레이드 정보  ui 표시 담당
/// </summary>
public class UpgradeView : MonoBehaviour
{
    [Header("------컴포넌트-------")]
    [SerializeField] TMP_Text _levelText;   //현재 레벨 텍스트
    [SerializeField] TMP_Text _sumText;     //(누적) 능력치 합계
    [SerializeField] TMP_Text _costText;    //필요한 비용
    [SerializeField] TMP_Text _valueText;   //얼마씩 증가하는지 


    public void UpdateLevel(int level)
    {
        _levelText.text = $"Lv. {level}";
       
    }
    public void UpdateSum(float sum)
    {
        // 1.문자열 연결 연산자
        //_sumText.text = "데미지: " + sum;
        // 2. 문자열 보간
        //_sumText.text = $"대미지: {sum}";
        // 3. string.Format() 방식
        _sumText.text = string.Format("대미지 : {0}", sum);
    
    }
    
    public void UpdateCost(float cost)
    {
        _costText.text = cost.ToString("F0");
    }

    public void UpdateValue(float value)
    {
        _valueText.text = string.Format("+ {0} DPS", value);

    }


    /// <summary>
    /// 업그레이드 뷰를 갱신하는 함수
    /// </summary>
    /// <param name="level">레벨</param>
    /// <param name="sum">능력치 합</param>
    /// <param name="cost">비용</param>
    /// <param name="value">이번 레벨업 시 능력치 증가량</param>
    public void UpdateView(int level, float sum, float cost, float value)
    {
        UpdateLevel(level);
        UpdateSum(sum);
        UpdateCost(cost);
        UpdateValue(value);
    }


}
