using System.Collections;
using TMPro;
using UnityEngine;


/// <summary>
/// 코르틴 써볼거 쿨타임과 비슷함
/// </summary>
public class DamageViewEx : MonoBehaviour
{

    [Header("----- 컴포넌트 -------")]
    [SerializeField] TMP_Text _damageText;
    [SerializeField] RectTransform _tr; //대미지 트랜스폼 렉트


    public void UpdateDamageView(float damage)
    {
        _damageText.text = damage.ToClickerString("{0:N0}");

    }

    public void Remove()
    {
        Destroy(gameObject);
    }

    private void Start()
    {
        StartCoroutine(PlayRoutine());
    }

    IEnumerator PlayRoutine()
    {
        float posY = 0;
        float targetPosY = 0;

        while (posY < targetPosY)
        {
            //posY를 초당 100만큼 증가
            posY += Time.deltaTime * 100;

            Vector2 pos = _tr.anchoredPosition;
            // 수정한 posY
            pos.y = posY;
            _tr.anchoredPosition = pos;
        
            //한 프레임 대기
            yield return null;
        }
    }

}
