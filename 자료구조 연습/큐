using System.Collections.Generic;
using TMPro;
using UnityEngine;

/*
큐(Queue)
- 선입선출(FIFO: First In, First Out)
- 먼저 들어온 자료가 먼저 나오는 자료구조
 
ex. 행동(명령) 대기열, 네트워크 패킷 처리
*/

public class QueueStudy : MonoBehaviour
{
    [SerializeField] TMP_Text _elemPrefab;

    // 큐는 인스펙터뷰를 지원하지 않는다.
    [SerializeField] Queue<TMP_Text> _queue = new Queue<TMP_Text>();
    [SerializeField] int _counter = 0;


    /// <summary>
    /// 큐에 요소를 하나 추가하는 함수
    /// </summary>
    public void Enqueue()
    {
        // 자신 게임오브젝트의 자식으로 _elemPrefab 복제본을 씬에 생성 후
        // 그것을 elem 변수로 가리킨다.
        TMP_Text elem = Instantiate(_elemPrefab, transform);

        elem.text = _counter.ToString();

        _queue.Enqueue(elem);

        _counter++;
    }

    /// <summary>
    /// 큐에서 요소를 하나 꺼내오는 함수
    /// </summary>
    public void Dequeue()
    {
        // 큐에 저장된 요소 수가 0개이면
        if (_queue.Count == 0) return;

        // 큐에 저장된 가장 오래된 요소 꺼내기
        TMP_Text elem = _queue.Dequeue();

        elem.color = Color.red;
    }

    public void Peek()
    {
        if (_queue.Count == 0) return;

        // 큐에 저장된 가장 오래된 요소 엿보기
        TMP_Text elem = _queue.Peek();

        elem.color = Color.yellow;
    }

    public void SetAllColorGreen()
    {
        foreach(var elem in _queue)
        {
            elem.color = Color.green;
        }
    }

    private void Update()
    {
        if(Input.GetKeyDown(KeyCode.Alpha1) == true)
        {
            Enqueue();
        }
        if(Input.GetKeyDown(KeyCode.Alpha2) == true)
        {
            Dequeue();
        }
        if(Input.GetKeyDown(KeyCode.Alpha3) == true)
        {
            Peek();
        }
        if(Input.GetKeyDown(KeyCode.Alpha4) == true)
        {
            SetAllColorGreen();
        }
    }
}
