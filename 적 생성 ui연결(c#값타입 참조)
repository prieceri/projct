/// <summary>
/// 적 캐릭터 총괄 담당(피격 기능)
/// </summary>
public class Enemy : MonoBehaviour
{
    [Header("----- 컴포넌트 -----")]
    [SerializeField] EnemyModel _model;     // 런타임 데이터(로직)

    [Header("----- 컴포넌트(읽기 전용) -----")]
    [SerializeField] EnemyView _view;       // 뷰(UI)

    /// <summary>
    /// 초기화 함수
    /// (게임에 사용할 준비를 하는 함수)
    /// </summary>
    /// <param name="view"></param>
    public void Initialize(EnemyView view)
    {
        _view = view;
    }

    /// <summary>
    /// 공격을 받는 함수(피격 함수)
    /// </summary>
    /// <param name="damage">대미지</param>
    public void TakeHit(float damage)
    {
        if (_model.CurrentHp <= 0) return;
            
        // 로직
        // 모델이 대미지를 입는다.
        _model.TakeDamage(damage);

        // 뷰
        // UI 갱신
        _view.UpdateHp(_model.CurrentHp, _model.MaxHp);

        // TODO
        // 대미지 텍스트 연출
    }
}
